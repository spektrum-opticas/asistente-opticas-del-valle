{
  "rewrites": [
    { "source": "/icon-192.png", "destination": "/api/icon?s=192" },
    { "source": "/icon-512.png", "destination": "/api/icon?s=512" },
    { "source": "/apple-touch-icon.png", "destination": "/api/icon?s=192" }
  ],
  "headers": [
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/manifest.webmanifest", "headers": [{ "key": "Content-Type", "value": "application/manifest+json" }] }
  ]
}
